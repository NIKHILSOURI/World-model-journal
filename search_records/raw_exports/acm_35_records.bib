abstract = {The Shadow of the Czar is a Webby-honored, jazz-infused noir game featuring breakthrough use of gaussian splat (3DGS) generation, editing and rendering techniques in the browser. This demo will show how in just six weeks I solo-developed and open sourced the cross-platform, WebXR-enabled game.},
