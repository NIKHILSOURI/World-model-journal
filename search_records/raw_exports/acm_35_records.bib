author = {Fr{\"o}hlich, Thomas and Alexandrovsky, Dmitry and Stabbert, Timo and D{\"o}ring, Tanja and Malaka, Rainer},
title = {VRBox: A Virtual Reality Augmented Sandbox for Immersive Playfulness, Creativity and Exploration},
